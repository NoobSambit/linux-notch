# copias de seguridad y temporales
*.bak
*.orig
*.rej
*~

# capturas de trabajo que no forman parte del proyecto
/scratch/

# Los .pyc de tools/, que aparecen al importar editar.py desde las pruebas.
tools/__pycache__/
externos
recargas

#  El banco de pruebas de un plugin: lo genera y lo borra
#  tools/plugins.py --probar, pero si algo peta puede quedarse.
.banco.qml

# Notchbar review media: keep concepts and large/private material out of normal adds.
/review/**/references/submitted/*
/review/**/references/alternatives/*
/review/**/references/storyboards/*
!/review/**/references/submitted/.gitkeep
!/review/**/references/alternatives/.gitkeep
!/review/**/references/storyboards/.gitkeep
/review/**/*.mp4
/review/**/*.webm
/review/**/*.mov
/review/**/*.mkv
/review/**/*.gif
/review/**/*.zip
/review/**/*.xcf
/review/**/*.psd
/review/**/*.tmp
/review/**/private/
